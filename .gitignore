# Python runtime
.venv/
.venv-workers/
__pycache__/
*.pyc

# Node / Cloudflare
node_modules/
.wrangler/

# Build artifacts (should NOT be in repo)
python_modules/
pylock.toml
uv.lock

# Secrets — NEVER commit
.env
.env.*
*.token
*.credential
access.jsonl

# Local credentials. HANDOFF.md records where the Cloudflare API token lives.
.dev.vars
.dev.vars.*
.git-credentials
wrangler.toml.local
*.pem
*.key

# Test and benchmark artifacts
.pytest_cache/
tests/fixtures/__pycache__/
bench/cache/
bench/build.log
bench/run.log
bench/access_log.json

# Backfilled pool history. Deliberately NOT committed, unlike bench/snapshots.
# The distinction is whether the data can be recovered later: a snapshot records what a
# pool looked like on a day that is now gone, so a day not recorded never existed. A
# backfill is derived from chain history, which does not move -- anyone can regenerate
# it byte for byte with `python bench/backfill.py --date <the same date>`.
bench/backfill/
