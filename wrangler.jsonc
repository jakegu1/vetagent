{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vetagent",
  "main": "src/entry.py",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "routes": [
    { "pattern": "vetagent.dev", "custom_domain": true }
  ],
  "vars": {
    "ENV": "production"
  },
  // 用量观测。刻意**不记录被查询的代币地址**——那是用户的查询意图，
  // 能反推出他打算买什么。隐私政策承诺了不留存，这里就必须守住。
  // 代价是我们不知道热门标的；换来的是「我们不记录你查了什么」这句话是真的。
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "vetagent_calls" }
  ]
}
