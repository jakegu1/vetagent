{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/no_untagged_probe.py\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "checking the probe is named"
          }
        ]
      }
    ]
  }
}
